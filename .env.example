# Patizan Records — Environment Configuration Template
# Duplicate this file to .env and fill in your Supabase project credentials.
# Obtain these from: Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application Settings
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=Patizan Records

# =========================================================================
# Server-Side WhatsApp Business Notification Settings (Supabase Secrets / Edge Function)
# DO NOT prefix these with VITE_ to keep them private and server-side only.
# =========================================================================

# Owner WhatsApp Number (International E.164 format, e.g. +19592056476)
OWNER_WHATSAPP_NUMBER=+1XXXXXXXXXX

# Option A: Meta WhatsApp Cloud API
WHATSAPP_API_TOKEN=your-meta-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# Option B: Twilio WhatsApp API
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=+14155238886
